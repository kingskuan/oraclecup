# Copy to .env and fill in.
# The deployer wallet's private key (NO 0x prefix needed by some tools — keep 0x for ethers).
PRIVATE_KEY=0x...

# (Optional) Override default Oracle address. Defaults to deployer.
# ORACLE_ADDRESS=0x...

# (Optional) Charity address that receives 1% of every settled pool. Leave blank for none.
# CHARITY_ADDRESS=0x...

# (Optional) RPC overrides
# XLAYER_RPC=https://rpc.xlayer.tech
# XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
